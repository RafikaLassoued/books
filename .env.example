# Copy this file to .env and set the values for your Supabase project.
# Use VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, and VITE_ADMIN_SECRET in Vercel environment variables too.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ADMIN_SECRET=your-admin-secret-key

# Optional local dev overrides
# VITE_API_URL=
# VITE_OTHER_KEY=
