# Copy this file to .env and set the values for your Supabase project.
# Use VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY in Vercel environment variables too.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

